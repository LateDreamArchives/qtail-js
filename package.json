{
  "name": "qtail-js",
  "version": "2.0.0",
  "description": "一个轻量级的用于生成带小尾巴的 qq 昵称的 JavaScript 库",
  "scripts": {
    "build": "node esbuild.config.js",
    "postbuild": "tsc --emitDeclarationOnly --outDir types --excludeFiles"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/LateDreamXD/qtail-js.git"
  },
  "keywords": [
    "qtail",
    "qq",
    "nickname"
  ],
  "author": "LateDreamXD",
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/LateDreamXD/qtail-js/issues"
  },
  "homepage": "https://github.com/LateDreamXD/qtail-js#readme",
  "devDependencies": {
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3"
  }
}
